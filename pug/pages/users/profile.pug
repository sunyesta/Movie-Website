extends /layouts/default.pug
include /components/moviePoster.pug

//- Page params: username, movies

block body 
    div.flex.flex-col.flex-center.flex-align-center.margin-small
        .background-trans-black.flex.flex-col.flex-align-center.flex-center.bevel.margin-medium.padding-small 
            h1.button-red.bevel.padding-small Your Information
            table#userdata-table
                tr
                    th name
                    td #{currentUser.name}
                tr
                    th username
                    td #{currentUser.username}
                tr
                    th email
                    td #{currentUser.email}
                tr 
                    th address
                    td #{currentUser.address}
                tr 
                    th creditcard
                    td #{currentUser.creditcard}
        a(href=root+"/users/ticket-history")
            button.button-1.button-blue Purchase History
