extends /layouts/conformation.pug

include /components/date.pug
include /components/moviePoster.pug

block meta
	meta(ticketData=ticketData)

block content 

	div.flex.flex-row.flex-start.stretch
		- let movieEditLink = root+"/home/"+ticketData.movieName
		a(href=movieEditLink)
			button.button-1.button-red
				i.fa.fa-arrow-left.fa-fw
				|edit
	h1.margin-medium Your Order:
	.flex.flex-row-collapse.flex-spread-centered.fill-w
		div.small
			img.moviePoster.bevel.fill-h.small(src=ticketData.moviePosterURL)
		div.flex.flex-start.flex-col.flex-align-start


			h2 #{ticketData.movieName}
			h2 time: 
				+date(ticketData.date)
				| 
				+time(ticketData.date)
			h2 tickets: #{ticketData.tickets}
	form(action=root+"/tickets/buy" method="POST")
		input(name = "ticketData" value=ticketData type="hidden") 
		button(type = "submit" )#purchase.margin-medium.button-1.button-blue.button-fill purchase

	script(src=root+'/js/confirmTicketOrder.js')