mixin slideWrapper()
	div#users-slide-wrapper
		div#users-slide.flex.flex-col.flex-align-center.padding-small.child-margin-tiny.bevel
			div.flex.flex-row.child-margin-tiny
				a(href=root+"/users/ticket-history")
					button.button-1.button-fill.button-blue Purchase History
				- let profileLink = root+`/users/profile`
				a(href=profileLink)
					button.button-1.button-fill.button-blue
						i.fa.fa-user
			form(action=root+"/logout?_method=DELETE" method="POST").fill-w
				button(type = "submit").button-2.button-fill.button-red.fill-w logout
					| 
					span.fa.fa-sign-out-alt

			div.horizontal-line
			h3 Signed In
			each user in users
				if user.username == currentUser.username
					- continue
				div.flex.flex-row.flex-center.fill-w.flex-spread-max
					form(action=root+"/login" method="POST").fill-w
						input(type="hidden" name="username" value=user.username)
						input(type="hidden" name="password" value=user.password)
						button(type="submit").button-1.button-fill.button-blue.flex-grow.fill-w #{user.name}
					form(action=root+"/dummy-logout" method="POST")
						input(type="hidden" name="username" value=user.username)
						button(style = {"margin-left":"10px"} type="submit").button-1.button-fill.button-red
							i.fa.fa-sign-out-alt.fa-solid

			a(href=root+"/users/login").fill-w
				button.button-1.button-fill.button-blue.fill-w +

div#header-wrapper
	header#top.flex.flex-start.flex-row.flex-spread-max.red-to-blue.bevel(style="height:70px") 
		div.flex.flex-row.flex-center.fill-h

			a.flex.flex-row.flex-center.fill-h.margin-medium(href=root+"/home")
				img.margin-small.fill-h(src=root+"/images/logo.png")
				h1#logo-title.text-white XD Movies
		div.margin-medium



			if currentUser
				//- div.flex
				//- 	form(action="/logout?_method=DELETE" method="POST")
				//- 		button(type="submit") logout
				//- 	div#otherUsersButton.button-grey.flex.flex-center.flex-row
				//- 		i.fa.fa-arrow-right.margin-small
				//- 		a(href="/users/ticket-history")
				//- 			button.button-1.button-blue

				//- 				| Hello, #{currentUser.username}


				div.flex.expand-left-wrapper
					button#users-btn.button-1.button-blue.button-raise Hello, #{currentUser.name}
						| 
						span.fa.fa-caret-down






			else
				a#signup(href=root+"/users/login")
					button.button-1.button-grey.button-fill signup/login


	div.fill-w.zero-h.flex.flex-row.flex-end.flex-align-start 
		+slideWrapper()


script(src=root+'/js/header.js')